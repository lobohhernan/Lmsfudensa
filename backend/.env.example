# ==========================================
# LMS Fudensa Backend — Variables de Entorno
# ==========================================
#
# INSTRUCCIONES:
# 1. Copia este archivo a `.env` en backend/
# 2. Reemplaza los valores con tus credenciales reales
# 3. NUNCA hagas commit de .env (está en .gitignore)
# 4. Obtén las claves de: Supabase Dashboard > Settings > API
#
# ⚠️ SEGURIDAD: Este archivo contiene SOLO placeholders
# Las credenciales reales NUNCA van en .env.example
#
# ==========================================

# Supabase Connection (REQUERIDO)
# Obtener de: https://supabase.com/dashboard/project/YOUR_PROJECT_ID/settings/api
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key (REQUERIDO - readonly desde cliente)
# Obtener de: Settings > API > anon public
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (CRÍTICO - acceso total a BD)
# Obtener de: Settings > API > service_role (secret key)
# ⚠️ NUNCA COMPARTIR PÚBLICAMENTE
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Desarrollo
NODE_ENV=development
PORT=54321