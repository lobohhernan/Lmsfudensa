# ============================================
# LMS FUDENSA - Variables de Entorno Frontend
# ============================================
#
# INSTRUCCIONES:
# 1. Copia este archivo como `.env.local` en frontend/
# 2. Reemplaza los valores con tus credenciales reales
# 3. NUNCA hagas commit de .env.local (está en .gitignore)
# 4. Los valores aquí son SOLO ejemplos/plantillas

# ✅ REQUERIDAS: Conexión a Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-from-supabase-dashboard

# ✅ REQUERIDAS: Integraciones Externas
VITE_MERCADO_PAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 🔐 ADMIN OPERATIONS: Ahora manejadas via Edge Functions (admin-operations)
# La SERVICE_ROLE_KEY ya NO se necesita en el frontend.
# Se configura automáticamente en el servidor de Supabase Edge Functions.
