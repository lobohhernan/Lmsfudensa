# ============================================
# LMS FUDENSA - Variables de Entorno Frontend
# ============================================
#
# INSTRUCCIONES:
# 1. Copia este archivo como `.env.local` en frontend/
# 2. Reemplaza los valores con tus credenciales reales
# 3. NUNCA hagas commit de .env.local (está en .gitignore)
# 4. Los valores aquí son SOLO ejemplos/plantillas

# ✅ REQUERIDAS: Conexión a Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-from-supabase-dashboard

# ✅ REQUERIDAS: Integraciones Externas
VITE_MERCADO_PAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_SENDGRID_API_KEY=SG.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 🔐 ADMIN ONLY: Service Role Key (para Admin Panel)
# ⚠️ CRÍTICO: NUNCA compartir públicamente (acceso total a BD)
# Obtener de: Supabase Dashboard > Settings > API > service_role (secret key)
# NO incluir en .env.local.example, solo aquí como referencia
# VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ⚠️ OPCIONAL: Storage Key (tiene fallback a lmsfudensa.supabase.auth)
# VITE_SUPABASE_STORAGE_KEY=lmsfudensa.supabase.auth
